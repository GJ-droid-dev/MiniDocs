# MiniDocs Server Configuration

# Neon Serverless Postgres Connection String
# Example: postgres://<user>:<password>@<ep-endpoint-pooler>.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/minidocs?sslmode=disable

# CORS Allowed Origin for Frontend (e.g. http://localhost:5173 or https://<app>.vercel.app)
CORS_ORIGIN=http://localhost:5173

# Directory for file attachment uploads
UPLOAD_DIR=./uploads

# Server Port
PORT=5000
